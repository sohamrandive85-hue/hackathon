# ContinuAI Environment Configuration

# Active LLM Provider: gemini | anthropic | openai | rule-based
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Web Application
BASE_URL=http://localhost:5000
PORT=5000
FLASK_SECRET_KEY=your_random_secret_key_hex
TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_base64

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GitLab OAuth 2.0 (Optional)
# GITLAB_CLIENT_ID=your_gitlab_client_id_here
# GITLAB_CLIENT_SECRET=your_gitlab_client_secret_here
# GITLAB_BASE=https://gitlab.com

# Integrations (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=your_email@example.com
# JIRA_API_TOKEN=your_jira_api_token
# JIRA_PROJECT_KEY=PROJ
# JIRA_ISSUE_TYPE=Epic
# NOTION_TOKEN=secret_...
# NOTION_DATABASE_ID=your_database_id
# NOTION_TITLE_PROP=Name
# INTEGRATIONS_DRY_RUN=1
